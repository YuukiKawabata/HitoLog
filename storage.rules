rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userID) {
      return signedIn() && request.auth.uid == userID;
    }

    function isActiveCircleMember(circleID) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.isDeleted != true
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.isSuspended != true
        && firestore.exists(/databases/(default)/documents/circles/$(circleID))
        && firestore.get(/databases/(default)/documents/circles/$(circleID)).data.status == 'active'
        && firestore.exists(/databases/(default)/documents/circles/$(circleID)/members/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/circles/$(circleID)/members/$(request.auth.uid)).data.status == 'active';
    }

    match /circleMedia/{circleID}/drafts/{userID}/{fileName} {
      allow read: if isActiveCircleMember(circleID);
      allow create: if isOwner(userID)
        && isActiveCircleMember(circleID)
        && resource == null
        && request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg';
      // Draft object paths are immutable. Posted entries may reference them, so
      // replacing the bytes at the same path would otherwise alter history.
      allow update: if false;
      allow delete: if isOwner(userID) && isActiveCircleMember(circleID);
    }

    match /circleMedia/{circleID}/{allPaths=**} {
      allow read: if isActiveCircleMember(circleID);
      allow write: if false;
    }

    // 低コスト保管モード（Documentation/COST_SAFE_MODE.md）: 旧SNSのメディアは新規アップロードを止める。
    // true に戻すと再開する。閲覧と、本人による削除はできる。
    function legacySocialUploadsEnabled() {
      return false;
    }

    match /postMedia/{userID}/{postID}/{fileName} {
      allow read: if signedIn();
      allow create, update: if legacySocialUploadsEnabled()
        && isOwner(userID)
        && request.resource.size <= 100 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType.matches('video/.*')
        );
      allow delete: if isOwner(userID);
    }

    match /postMedia/{userID}/{postID}/thumbs/{fileName} {
      allow read: if signedIn();
      allow create, update: if legacySocialUploadsEnabled()
        && isOwner(userID)
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isOwner(userID);
    }
  }
}
