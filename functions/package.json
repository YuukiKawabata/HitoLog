    "test": "npm run build && node --test test/*.test.cjs"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^3.1.0",
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.3.2"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
