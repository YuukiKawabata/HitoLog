default_platform(:ios)

platform :ios do
  private_lane :connect_api_key do
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID", "5F3H9LTR2Y"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID", "267a8430-2d83-4339-aeb5-1187988ce123"),
      key_filepath: ENV.fetch(
        "ASC_KEY_FILEPATH",
        File.expand_path("~/.appstoreconnect/private_keys/AuthKey_5F3H9LTR2Y.p8")
      )
    )
  end

  desc "Show the latest TestFlight build number for version 1.3"
  lane :latest_build do
    latest = latest_testflight_build_number(
      api_key: connect_api_key,
      app_identifier: "com.yukikawabata.HitoLog",
      version: "1.3",
      initial_build_number: 0
    )
    UI.success("Latest TestFlight build for 1.3: #{latest}")
  end

  desc "Build and upload HitoLog to TestFlight"
  lane :beta do
    api_key = connect_api_key

    build_app(
      project: "HitoLog.xcodeproj",
      scheme: "HitoLog",
      configuration: "Release",
      export_method: "app-store",
      clean: true
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: false,
      distribute_external: false
    )
  end

  desc "Upload the prepared App Store screenshots for version 1.3"
  lane :release_screenshots do
    ENV["FASTLANE_ENABLE_BETA_DELIVER_SYNC_SCREENSHOTS"] = "1"

    api_key = connect_api_key

    deliver(
      api_key: api_key,
      app_identifier: "com.yukikawabata.HitoLog",
      app_version: "1.3",
      screenshots_path: "fastlane/screenshots",
      skip_metadata: true,
      skip_binary_upload: true,
      overwrite_screenshots: false,
      sync_screenshots: true,
      force: true,
      submit_for_review: false,
      run_precheck_before_submit: false
    )
  end

end
