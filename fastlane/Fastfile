# fastlane and xcpretty crash on Japanese build output under a US-ASCII locale
# (e.g. shells started without LANG). Force UTF-8 for this process and children.
ENV["LANG"] = "en_US.UTF-8"
ENV["LC_ALL"] = "en_US.UTF-8"
Encoding.default_external = Encoding::UTF_8

default_platform(:ios)

platform :ios do
  private_lane :connect_api_key do
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID", "5F3H9LTR2Y"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID", "267a8430-2d83-4339-aeb5-1187988ce123"),
      key_filepath: ENV.fetch(
        "ASC_KEY_FILEPATH",
        File.expand_path("~/.appstoreconnect/private_keys/AuthKey_5F3H9LTR2Y.p8")
      )
    )
  end

  desc "Show the latest TestFlight build number for version 2.0.1"
  lane :latest_build do
    latest = latest_testflight_build_number(
      api_key: connect_api_key,
      app_identifier: "com.yukikawabata.HitoLog",
      version: "2.0.1",
      initial_build_number: 0
    )
    UI.success("Latest TestFlight build for 2.0.1: #{latest}")
  end

  desc "Build a signed App Store IPA for Wamori without uploading"
  lane :build do
    api_key = connect_api_key

    # The Xcode-managed store profile lacks the current Apple Distribution
    # certificate, and the API key has no cloud signing permission, so export
    # with the manual profile instead. readonly: never creates portal profiles.
    get_provisioning_profile(
      api_key: api_key,
      app_identifier: "com.yukikawabata.HitoLog",
      provisioning_name: "Wamori App Store (manual) 20260928",
      ignore_profiles_with_different_name: true,
      readonly: true
    )

    build_app(
      project: "HitoLog.xcodeproj",
      scheme: "HitoLog",
      configuration: "Release",
      clean: true,
      export_options: {
        method: "app-store-connect",
        signingStyle: "manual",
        signingCertificate: "Apple Distribution",
        teamID: "976WT2WW6X",
        provisioningProfiles: {
          "com.yukikawabata.HitoLog" => lane_context[SharedValues::SIGH_UUID]
        }
      }
    )
  end

  desc "Build and upload Wamori to TestFlight"
  lane :beta do
    api_key = connect_api_key

    build

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: false,
      distribute_external: false
    )
  end

  desc "Upload the prepared App Store screenshots for version 2.0.1"
  lane :release_screenshots do
    ENV["FASTLANE_ENABLE_BETA_DELIVER_SYNC_SCREENSHOTS"] = "1"

    api_key = connect_api_key

    deliver(
      api_key: api_key,
      app_identifier: "com.yukikawabata.HitoLog",
      app_version: "2.0.1",
      screenshots_path: "fastlane/screenshots",
      skip_metadata: true,
      skip_binary_upload: true,
      overwrite_screenshots: false,
      sync_screenshots: true,
      force: true,
      submit_for_review: false,
      run_precheck_before_submit: false
    )
  end

  desc "Submit Wamori 2.0.1 (build 13) for review and reset the summary rating"
  lane :submit_review do
    deliver(
      api_key: connect_api_key,
      app_identifier: "com.yukikawabata.HitoLog",
      app_version: "2.0.1",
      build_number: "13",
      skip_binary_upload: true,
      skip_screenshots: true,
      release_notes: {
        "ja" => "「みんなの投稿」は閲覧のみになりました。輪での記録・コメント・リアクションは、これまでどおりご利用いただけます。初回起動時の表示を改善し、そのほか軽微な不具合を修正しました。"
      },
      # reset_ratings fails with an API key (no public resetRatingsRequests endpoint,
      # fastlane/fastlane#21328). Tick "Reset summary rating" in App Store Connect instead.
      reset_ratings: false,
      automatic_release: true,
      submit_for_review: true,
      submission_information: { add_id_info_uses_idfa: false },
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false,
      force: true
    )
  end

  desc "Validate Wamori App Store metadata before review submission"
  lane :release_precheck do
    precheck(
      api_key: connect_api_key,
      app_identifier: "com.yukikawabata.HitoLog",
      platform: "ios",
      default_rule_level: :warn,
      # Fastlane cannot inspect IAP with an App Store Connect API key.
      # Existing product IDs are unchanged and are audited separately.
      include_in_app_purchases: false,
      use_live: false
    )
  end

end
